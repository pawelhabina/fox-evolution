server {
    server_name foxevo.mionix.pl;

    location = /updates/latest.yml {
        alias /var/www/fox-evo/updates/latest.yml;
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location = /updates/latest-mac.yml {
        alias /var/www/fox-evo/updates/latest-mac.yml;
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    location /updates/ {
        alias /var/www/fox-evo/updates/;
        add_header Access-Control-Allow-Origin *;
        add_header Cache-Control "no-cache, must-revalidate";
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:4000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/foxevo.mionix.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/foxevo.mionix.pl/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

server {
    listen 80;
    server_name foxevo.mionix.pl;
    return 301 https://$host$request_uri;
}
