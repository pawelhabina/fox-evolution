{
  "name": "fox-evolution-v2",
  "version": "1.1.20",
  "description": "Merge Fox Tycoon",
  "main": "electron/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:all": "concurrently -k \"npm --prefix server run dev\" \"npm run dev\"",
    "dev:server": "npm --prefix server run dev",
    "build:web": "vite build",
    "build": "npm run build:web && electron-builder",
    "build:win": "npm run build:web && electron-builder --win nsis --x64 --publish never",
    "updates:publish": "node scripts/publish-updates.mjs",
    "release:desktop": "npm run build && npm run updates:publish && npm run nextcloud:publish",
    "release:win:s1": "npm run build:win && npm run updates:publish && npm run deploy:s1 && npm run nextcloud:publish",
    "preview": "vite preview",
    "server:prisma:generate": "npm --prefix server run prisma:generate",
    "server:prisma:push": "npm --prefix server run prisma:push",
    "server:seed:admin": "npm --prefix server run seed:admin",
    "deploy:s1": "node scripts/deploy-s1.mjs",
    "nextcloud:publish": "node scripts/publish-nextcloud.mjs"
  },
  "build": {
    "appId": "com.foxevolution.app",
    "productName": "Fox Evolution",
    "artifactName": "Fox-Evolution-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app/fox-evolution-icon.png",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "icon": "build/icon.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": "AppImage"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://foxevo.mionix.pl/updates"
      }
    ],
    "nsis": {
      "guid": "1ee6b1b9-d9d8-510c-8447-aa898aa9b61d",
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "merge-game"
  ],
  "author": "Mionix Games",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3"
  }
}
