{
  "name": "fox-evolution",
  "version": "1.0.0",
  "description": "Offline desktop merge game built with Electron + React + Vite + Tailwind",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5173 && electron electron/main.js\"",
    "dev:all": "concurrently -k \"npm --prefix server run dev\" \"npm run dev\"",
    "dev:server": "npm --prefix server run dev",
    "build:web": "vite build",
    "build": "npm run build:web && electron-builder",
    "updates:publish": "node scripts/publish-updates.mjs",
    "release:desktop": "npm run build && npm run updates:publish",
    "preview": "vite preview",
    "server:prisma:generate": "npm --prefix server run prisma:generate",
    "server:prisma:push": "npm --prefix server run prisma:push",
    "server:seed:admin": "npm --prefix server run seed:admin"
  },
  "build": {
    "appId": "com.foxevolution.app",
    "productName": "Fox Evolution",
    "artifactName": "Fox-Evolution-${version}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "merge-game"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "electron-updater": "^6.6.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "electron": "^36.3.1",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0",
    "wait-on": "^8.0.3"
  }
}
