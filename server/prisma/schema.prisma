generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum PrincipalType {
  USER
  DEVICE
}

enum OAuthProvider {
  GOOGLE
  STEAM
}

enum LeaderboardCategory {
  COINS
  GEMS
  TOP_TIER
}

enum FlagSource {
  AUTO
  ADMIN
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

enum AdminMessageAudience {
  GLOBAL
  USER
}

model User {
  id                     String                 @id @default(cuid())
  publicId               String?                @unique
  email                  String?                @unique
  passwordHash           String?
  sessionVersion         Int                    @default(0)
  displayName            String
  nicknameChangedAt      DateTime?
  profileSetupRequired   Boolean                @default(false)
  role                   UserRole               @default(USER)
  isFlagged              Boolean                @default(false)
  flagReason             String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  lastLoginAt            DateTime?
  oauthIdentities        OAuthIdentity[]
  saves                  GameSave[]
  refreshTokens          RefreshToken[]
  flags                  CheatFlag[]            @relation("UserFlags")
  adminCreatedFlags      CheatFlag[]            @relation("AdminCreatedFlags")
  deviceLinks            UserDeviceLink[]
  auditLogs              AuditLog[]             @relation("AdminAuditLogs")
  leaderboardRows        LeaderboardEntry[]
  telemetryEvents        TelemetryEvent[]
  adminMessagesCreated   AdminMessage[]         @relation("AdminMessageAuthor")
  adminMessageDeliveries AdminMessageDelivery[]
  sentFriendRequests     Friendship[]           @relation("FriendshipRequester")
  receivedFriendRequests Friendship[]           @relation("FriendshipAddressee")
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  requester   User             @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User             @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([requesterId, status])
  @@index([addresseeId, status])
}

model Device {
  id              String           @id @default(cuid())
  deviceKeyHash   String           @unique
  label           String?
  isFlagged       Boolean          @default(false)
  flagReason      String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  saves           GameSave[]
  refreshTokens   RefreshToken[]
  flags           CheatFlag[]      @relation("DeviceFlags")
  userLinks       UserDeviceLink[]
  telemetryEvents TelemetryEvent[]
}

model UserDeviceLink {
  id       String   @id @default(cuid())
  userId   String
  deviceId String
  linkedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
}

model OAuthIdentity {
  id             String        @id @default(cuid())
  provider       OAuthProvider
  providerUserId String
  userId         String
  createdAt      DateTime      @default(now())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
}

model RefreshToken {
  id             String        @id @default(cuid())
  tokenHash      String        @unique
  principalType  PrincipalType
  sessionVersion Int           @default(0)
  userId         String?
  deviceId       String?
  expiresAt      DateTime
  revokedAt      DateTime?
  replacedById   String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime      @default(now())
  user           User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device         Device?       @relation(fields: [deviceId], references: [id], onDelete: Cascade)
}

model GameSave {
  id              String        @id @default(cuid())
  slotId          String
  name            String
  ownerType       PrincipalType
  userId          String?
  deviceId        String?
  state           Json
  summaryCoins    BigInt        @default(0)
  summaryGems     BigInt        @default(0)
  summaryTopTier  Int           @default(1)
  cheatScore      Int           @default(0)
  cheatNotes      Json?
  editedByAdminAt DateTime?
  lastWriterId    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  device          Device?       @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([userId, slotId])
  @@unique([deviceId, slotId])
  @@index([userId, updatedAt])
  @@index([deviceId, updatedAt])
}

model CheatFlag {
  id         String     @id @default(cuid())
  source     FlagSource
  reason     String
  score      Int
  userId     String?
  deviceId   String?
  adminId    String?
  createdAt  DateTime   @default(now())
  resolvedAt DateTime?

  user   User?   @relation("UserFlags", fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation("DeviceFlags", fields: [deviceId], references: [id], onDelete: Cascade)
  admin  User?   @relation("AdminCreatedFlags", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

model LeaderboardEntry {
  id          String              @id @default(cuid())
  category    LeaderboardCategory
  rank        Int
  value       BigInt
  generatedAt DateTime
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([category, rank])
  @@index([category, userId])
  @@index([category, generatedAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String
  details     Json?
  createdAt   DateTime @default(now())

  admin User @relation("AdminAuditLogs", fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
}

model TelemetryEvent {
  id            String        @id @default(cuid())
  principalType PrincipalType
  userId        String?
  deviceId      String?
  eventType     String
  payload       Json?
  createdAt     DateTime      @default(now())

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([eventType, createdAt])
  @@index([userId, createdAt])
  @@index([deviceId, createdAt])
}

model AdminMessage {
  id               String                 @id @default(cuid())
  audience         AdminMessageAudience
  title            String
  body             String                 @db.Text
  createdByAdminId String
  createdAt        DateTime               @default(now())
  createdByAdmin   User                   @relation("AdminMessageAuthor", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  deliveries       AdminMessageDelivery[]

  @@index([createdAt])
  @@index([audience, createdAt])
}

model AdminMessageDelivery {
  id        String       @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime?
  createdAt DateTime     @default(now())
  message   AdminMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt, createdAt])
}
